# Fork a started, idle Project thread from the header: "Forking…" shows, then the
# new "(fork)" thread opens. Also from an agent bubble's "Fork from here". The
# fixture stands in for the Mac; nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --contains "Reply 13. Continuing the project" --timeout 20
tap --id conversation-title-menu
wait --id fork-conversation --timeout 10
shot fork-header-menu
tap --id fork-conversation
wait --id fork-progress --timeout 5
shot fork-progress
wait --contains "Read status fixture (fork)" --timeout 20
wait --id fork-progress --gone --timeout 10
shot fork-opened
# From an agent reply
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --contains "Reply 13. Continuing the project" --timeout 20
hold --contains "Reply 13. Continuing the project"
wait --id fork-from-here --timeout 10
tap --id fork-from-here
wait --id fork-progress --timeout 5
wait --contains "Read status fixture (fork)" --timeout 20
shot fork-from-reply-opened

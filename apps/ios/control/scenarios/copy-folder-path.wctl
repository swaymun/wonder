# Long-press a Project thread in the sidebar: Copy folder path puts the thread's
# working folder on the pasteboard. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --id project-composer-model --timeout 15
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 10
clipboard --clear
hold --id pinned-thread:codex:read-fixture
wait --id copy-thread-folder --timeout 10
shot copy-folder-path-menu
tap --id copy-thread-folder
clipboard --contains "/fixture"
clipboard --show

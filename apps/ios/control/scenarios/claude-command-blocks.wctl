# A `!` shell command and a slash command run in Claude Code show as command
# cards, not bash-input or command-name tags. The host joins each command to its
# output (claude-runtime tests); the fixture serves history as the host projects
# it. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture project-command-blocks
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --id slash-command-chip --timeout 20
wait --contains "bash-input" --gone --timeout 3
wait --contains "command-name" --gone --timeout 3
wait --contains "git status --short" --timeout 5
wait --id command-card-output --timeout 5
wait --id command-card-errors --timeout 5
wait --contains "No such file or directory" --timeout 5
shot claude-command-blocks
# Output collapses and opens again from its toggle.
tap --id command-card-output-toggle
wait --id command-card-output --gone --timeout 5
shot claude-command-blocks-collapsed
tap --id command-card-output-toggle
wait --id command-card-output --timeout 5

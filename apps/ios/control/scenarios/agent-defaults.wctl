# New Chat and an existing Project thread show the host's default model with
# its resolved effort, and the Speed picker lists every tier and keeps a
# non-default choice. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-speed
wait --id project-agent-picker --timeout 30
wait --contains "Fixture model · High" --timeout 20
shot agent-defaults-new-chat
tap --id project-agent-picker
wait --id new-chat-speed:default --timeout 10
swipe up
wait --id new-chat-speed:fast
tap --id new-chat-speed:fast
shot agent-defaults-new-chat-speed
# The sheet's Done stays reachable while it is scrolled (short screens such as the Duo).
tap --label Done
wait --contains "Fixture model · High · Fast" --timeout 10
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --id project-composer-model --timeout 15
wait --contains "Fixture model · High" --timeout 10
shot agent-defaults-thread-composer
tap --id project-composer-model
wait --id project-speed:default --timeout 10
swipe up
wait --id project-speed:fast
shot agent-defaults-thread-speed
tap --id project-speed:fast
wait --contains "Fixture model · High · Fast" --timeout 10
tap --label Done
wait --id project-composer-model --timeout 10
wait --contains "Fixture model · High · Fast" --timeout 10
shot agent-defaults-thread-speed-saved

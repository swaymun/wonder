# When usage cannot be read, the header shows no usage pill at all.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-unavailable
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --id project-composer-model --timeout 15
wait --id conversation-title-menu
wait --id header-usage --gone
shot codex-header-usage-unavailable

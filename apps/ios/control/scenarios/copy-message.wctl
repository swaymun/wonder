# Long-press a user bubble and an agent bubble in a started Project thread: Copy
# puts that message's whole text on the pasteboard. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --contains "Reply 13. Continuing the project" --timeout 20
clipboard --clear
hold --contains "Reply 13. Continuing the project"
wait --id copy-message --timeout 10
shot copy-message-agent-menu
tap --id copy-message
clipboard --contains "Reply 13. Continuing the project at /p/app." --not-contains "Please continue"
hold --contains "Please continue"
wait --id copy-message --timeout 10
tap --id copy-message
clipboard --contains "Please continue" --contains "Continue the project at:" --not-contains "Reply 13"
clipboard --show
shot copy-message-user
# Select text: the same menu opens the whole message in a selectable sheet.
hold --contains "Reply 13. Continuing the project"
wait --id select-message-text-action --timeout 10
tap --id select-message-text-action
wait --id select-message-text --timeout 10
wait --contains "Reply 13. Continuing the project at /p/app." --timeout 5
shot select-message-text
tap --id select-message-done --type Button
wait --id select-message-text --gone --timeout 10

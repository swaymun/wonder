# A Codex thread's header shows its primary (5-hour) and secondary (weekly)
# usage, with no provider icon beside the name; Plan stays a composer chip.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture
wait --id open-sidebar --timeout 30
tap --id open-sidebar --type Button
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --id project-composer-model --timeout 15
wait --id header-usage --timeout 15
wait --label "5-hour limit 27% used, weekly 41% used"
wait --label "Read status fixture, Read status project, Codex, conversation options"
shot codex-header-usage

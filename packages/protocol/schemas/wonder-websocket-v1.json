{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonder.invalid/schema/websocket-v1.json",
  "title": "Wonder WebSocket v1 event",
  "type": "object",
  "required": [
    "eventId",
    "hostEpoch",
    "sequence",
    "occurredAt",
    "event"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "hostEpoch": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "data": {}
      },
      "additionalProperties": false
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "messageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "itemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvalId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

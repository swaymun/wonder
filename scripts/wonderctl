#!/usr/bin/env python3
"""Drive Wonder Testing in a dedicated iOS simulator for agent verification.

See apps/ios/CONTROL.md. Pass --host (or WONDER_CONTROL_HOST) to run on another Mac.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROJECT = ROOT / "apps/ios/Wonder.xcodeproj"
SOURCES = ROOT / "apps/ios/Wonder"
BUNDLE = "com.swaymun.wonder.testing"
PROFILES = {
    "iphone": ("Wonder Control iPhone", ("iPhone 17 Pro", "iPhone 17", "iPhone 16 Pro", "iPhone 16")),
    "duo": ("Wonder Control iPhone Duo", ("iPhone Duo",)),
}
DEVICE_NAME, DEVICE_TYPES = PROFILES[os.environ.get("WONDER_CONTROL_PROFILE", "iphone")]
CONTROL = ROOT / ".local/control"
EVIDENCE = CONTROL / "evidence"
DERIVED = Path(os.path.expanduser(os.environ.get("WONDER_CONTROL_DERIVED", ""))) if os.environ.get("WONDER_CONTROL_DERIVED") else ROOT / ".local/build/control-sim"
CORE_SIMCTL = "/Library/Developer/PrivateFrameworks/CoreSimulator.framework/Versions/A/Resources/bin/simctl"
# One remote copy per local checkout, so worktrees never overwrite each other's source.
REMOTE_DIR = f"wonder-control/{ROOT.name}-{hashlib.sha1(str(ROOT).encode()).hexdigest()[:8]}"
# Simulators are per machine, so their lock is too.
LOCKS = Path.home() / "Library/Caches/wonderctl"
REMOTE_PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SYNC_COMMANDS = {"sync", "build", "run"}


class ControlError(Exception):
    pass


def sh(cmd, check=True, capture=True, env=None, timeout=None):
    result = subprocess.run(cmd, text=True, capture_output=capture, env=env, timeout=timeout)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() if capture else ""
        raise ControlError(f"{shlex.join(cmd)} failed ({result.returncode}): {detail[-2000:]}")
    return result


def axe_binary():
    path = shutil.which("axe") or "/opt/homebrew/bin/axe"
    if not Path(path).exists():
        raise ControlError("AXe is not installed: brew install cameroncooke/axe/axe")
    return path


_simctl = None


def simctl(*args, **kwargs):
    # Xcode's simctl wrapper can add ~20s per call; call the CoreSimulator tool it execs.
    global _simctl
    if not _simctl:
        _simctl = CORE_SIMCTL if Path(CORE_SIMCTL).exists() else sh(["xcrun", "--find", "simctl"]).stdout.strip()
    return sh([_simctl, *args], **kwargs)


def devices():
    data = json.loads(simctl("list", "devices", "available", "-j").stdout)
    for runtime, entries in data["devices"].items():
        if "iOS" in runtime:
            for entry in entries:
                yield runtime, entry


def find_device():
    matches = [(runtime, d) for runtime, d in devices() if d["name"] == DEVICE_NAME]
    return max(matches, key=lambda item: item[0])[1] if matches else None


def create_device():
    runtimes = json.loads(simctl("list", "runtimes", "available", "-j").stdout)["runtimes"]
    ios = sorted((r for r in runtimes if r["platform"] == "iOS"), key=lambda r: r["version"])
    if not ios:
        raise ControlError("no available iOS simulator runtime")
    runtime = ios[-1]
    supported = {t["name"]: t["identifier"] for t in runtime.get("supportedDeviceTypes", [])}
    kind = next((supported[name] for name in DEVICE_TYPES if name in supported), None)
    if not kind:
        raise ControlError(f"none of {DEVICE_TYPES} supported by {runtime['name']}")
    simctl("create", DEVICE_NAME, kind, runtime["identifier"])
    return find_device()


def ensure_device(boot=True):
    device = find_device() or create_device()
    if boot and device["state"] != "Booted":
        simctl("boot", device["udid"], check=False)
        simctl("bootstatus", device["udid"], "-b", timeout=300)
        device = find_device()
        wait_for_automation(device["udid"])
    return device


def wait_for_automation(device_udid, limit=120):
    # The first accessibility session after boot can take minutes (iPhone Duo especially).
    deadline = time.time() + limit
    while True:
        result = sh([axe_binary(), "describe-ui", "--udid", device_udid], check=False)
        if result.returncode == 0:
            return
        if time.time() > deadline:
            raise ControlError(f"accessibility automation not ready after {limit}s: {result.stderr.strip()[-200:]}")
        time.sleep(3)


def udid():
    device = find_device()
    if not device or device["state"] != "Booted":
        raise ControlError(f"'{DEVICE_NAME}' is not booted; run: scripts/wonderctl device")
    return device["udid"]


def app_path():
    path = DERIVED / "Build/Products/TestingDiagnostics-iphonesimulator/Wonder.app"
    if not path.exists():
        raise ControlError("no simulator build; run: scripts/wonderctl build")
    return path


def evidence_path(name, suffix):
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    stem = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-") or "capture"
    return EVIDENCE / f"{time.strftime('%Y%m%d-%H%M%S')}-{stem}{suffix}"


def ui_tree():
    command = [axe_binary(), "describe-ui", "--udid", udid()]
    try:
        out = sh(command).stdout
    except ControlError as error:
        # A freshly booted simulator (notably iPhone Duo) can time out opening its
        # first automation session; retry that one readiness failure once.
        if "remote automation session" not in str(error):
            raise
        print(f"retrying describe-ui after: {str(error)[-120:]}", file=sys.stderr)
        out = sh(command).stdout
    return json.loads(out[out.index("["):] if "[" in out else out)


def walk(nodes):
    for node in nodes if isinstance(nodes, list) else [nodes]:
        yield node
        yield from walk(node.get("children") or [])


def matches(node, args):
    if args.id and node.get("AXUniqueId") != args.id:
        return False
    if args.label and node.get("AXLabel") != args.label:
        return False
    if getattr(args, "contains", None) and args.contains not in (node.get("AXLabel") or "") + str(node.get("AXValue") or ""):
        return False
    return True


def selector(args):
    if not (args.id or args.label or getattr(args, "contains", None)):
        raise ControlError("pass --id, --label or --contains")


def fixture_flags():
    flags = set()
    for path in SOURCES.rglob("*.swift"):
        flags.update(re.findall(r'"(-[a-z][a-z0-9]+(?:-[a-z0-9]+)+)"', path.read_text(errors="ignore")))
    return sorted(flags)


# Commands


def cmd_doctor(args):
    xcode = sh(["xcodebuild", "-version"], check=False).stdout.split("\n")[0]
    device = find_device()
    report = {
        "host": os.uname().nodename,
        "developer_dir": os.environ.get("DEVELOPER_DIR") or sh(["xcode-select", "-p"]).stdout.strip(),
        "xcode": xcode,
        "xcode_first_launch_done": sh(["xcodebuild", "-checkFirstLaunchStatus"], check=False).returncode == 0,
        "axe": sh([axe_binary(), "--version"], check=False).stdout.strip() if shutil.which("axe") or Path("/opt/homebrew/bin/axe").exists() else None,
        "device": device and {"name": device["name"], "udid": device["udid"], "state": device["state"]},
        "build": str(app_path()) if (DERIVED / "Build/Products/TestingDiagnostics-iphonesimulator/Wonder.app").exists() else None,
        "installed": False,
        "other_booted": [d["name"] for _, d in devices() if d["state"] == "Booted" and d["name"] != DEVICE_NAME],
    }
    if device and device["state"] == "Booted":
        report["installed"] = simctl("get_app_container", device["udid"], BUNDLE, check=False).returncode == 0
    print(json.dumps(report, indent=2))
    if not report["axe"] or not report["device"]:
        return 1


def cmd_device(args):
    if args.shutdown:
        device = find_device()
        if device and device["state"] == "Booted":
            simctl("shutdown", device["udid"])
        print("shut down")
        return
    # `simctl erase` can leave an iPhone Duo with a second display and dead input, so the
    # Duo (and --recreate on any profile) is deleted and created again instead.
    if args.recreate or (args.erase and DEVICE_NAME == PROFILES["duo"][0]):
        device = find_device()
        if device:
            if device["state"] == "Booted":
                simctl("shutdown", device["udid"])
            simctl("delete", device["udid"])
        create_device()
    elif args.erase:
        device = ensure_device(boot=False)
        if device["state"] == "Booted":
            simctl("shutdown", device["udid"])
        simctl("erase", device["udid"])
    device = ensure_device()
    print(device["udid"])


def cmd_build(args):
    device = ensure_device()
    CONTROL.mkdir(parents=True, exist_ok=True)
    log = CONTROL / "build.log"
    cmd = ["xcodebuild", "-project", str(PROJECT), "-scheme", "WonderTesting",
           "-configuration", "TestingDiagnostics", "-destination", f"id={device['udid']}",
           "-derivedDataPath", str(DERIVED), "build"]
    started = time.time()
    with open(log, "w") as handle:
        code = subprocess.run(cmd, stdout=handle, stderr=subprocess.STDOUT).returncode
    if code != 0:
        errors = [line for line in log.read_text(errors="ignore").splitlines() if " error: " in line]
        raise ControlError("build failed; see .local/control/build.log\n" + "\n".join(errors[-20:]))
    print(f"built in {time.time() - started:.0f}s: {app_path()}")
    if not args.no_install:
        cmd_install(args)


def cmd_install(args):
    simctl("install", udid(), str(app_path()))
    print(f"installed {BUNDLE}")


def cmd_launch(args):
    known = set(fixture_flags())
    flags = [f if f.startswith("-") or f"-diagnostics-{f}" not in known else f"-diagnostics-{f}"
             for f in args.fixture or []]
    flags = [f if f.startswith("-") else f"-{f}" for f in flags]
    unknown = [f for f in flags if f not in known]
    if unknown:
        raise ControlError(f"unknown fixture flag(s) {unknown}; see: scripts/wonderctl fixtures")
    env = dict(os.environ)
    for pair in args.env or []:
        key, _, value = pair.partition("=")
        env[f"SIMCTL_CHILD_{key}"] = value
    out = simctl("launch", "--terminate-running-process", udid(), BUNDLE,
                 *flags, *(args.arg or []), env=env).stdout.strip()
    print(out)


def cmd_terminate(args):
    simctl("terminate", udid(), BUNDLE, check=False)
    print("terminated")


def cmd_fixtures(args):
    print("\n".join(fixture_flags()))


def cmd_open(args):
    simctl("openurl", udid(), args.url)
    print(f"opened {args.url}")


def cmd_tap(args):
    if args.xy:
        x, y = args.xy.split(",")
        target = ["-x", x, "-y", y]
    else:
        selector(args)
        target = ["--id", args.id] if args.id else ["--label", args.label]
        if args.type:
            target += ["--element-type", args.type]
    sh([axe_binary(), "tap", *target, "--wait-timeout", str(args.timeout), "--udid", udid()])
    print("tapped")


def cmd_hold(args):
    """Long-press the centre of the first element matching the selector (opens context menus)."""
    selector(args)
    deadline = time.time() + args.timeout
    while True:
        found = [n for n in walk(ui_tree()) if matches(n, args) and n.get("frame")]
        if len(found) > args.nth:
            break
        if time.time() > deadline:
            raise ControlError(f"nothing to hold for {vars(args)}")
        time.sleep(0.4)
    f = found[args.nth]["frame"]
    x, y = f["x"] + f["width"] / 2, f["y"] + min(f["height"] / 2, args.max_y_offset)
    sh([axe_binary(), "touch", "-x", f"{x:.0f}", "-y", f"{y:.0f}", "--down", "--up", "--delay", str(args.seconds), "--udid", udid()])
    print(f"held {args.seconds}s at {x:.0f},{y:.0f}")


def cmd_back(args):
    """Tap the navigation back control. It is a Button on the iPhone and a GenericElement on
    the Duo, and an id can match several hidden copies, so take the on-screen one."""
    deadline = time.time() + args.timeout
    while True:
        nodes = list(walk(ui_tree()))
        screen = next((n["frame"] for n in nodes if n.get("type") == "Application" and n.get("frame")), None)
        found = [n for n in nodes if n.get("AXUniqueId") == "BackButton" and n.get("frame")
                 and screen and 0 <= n["frame"]["x"] < screen["width"] and 0 <= n["frame"]["y"] < screen["height"]
                 and n["frame"]["width"] > 0]
        if found:
            break
        if time.time() > deadline:
            raise ControlError("no back control on screen")
        time.sleep(0.4)
    f = found[-1]["frame"]
    x, y = f["x"] + f["width"] / 2, f["y"] + f["height"] / 2
    sh([axe_binary(), "tap", "-x", f"{x:.0f}", "-y", f"{y:.0f}", "--udid", udid()])
    print(f"went back via {x:.0f},{y:.0f}")


def cmd_type(args):
    sh([axe_binary(), "type", args.text, "--udid", udid()])
    print("typed")


def cmd_swipe(args):
    presets = {"up": "scroll-up", "down": "scroll-down", "left": "swipe-from-right-edge", "right": "swipe-from-left-edge"}
    if getattr(args, "inside", None):
        # Drag within one element, such as a list in a short panel. The presets only scroll
        # the middle of a 390x844 screen, which can miss it on the iPhone Duo.
        node = next((n for n in walk(ui_tree()) if n.get("AXUniqueId") == args.inside), None)
        if not node:
            raise ControlError(f"no element with id {args.inside!r} to swipe in")
        f = node["frame"]
        x = f["x"] + f["width"] / 2
        top, bottom = f["y"] + f["height"] * 0.2, f["y"] + f["height"] * 0.8
        if args.direction not in ("up", "down"):
            raise ControlError("--in supports up and down")
        start, end = (bottom, top) if args.direction == "up" else (top, bottom)
        sh([axe_binary(), "swipe", "--start-x", f"{x:.0f}", "--start-y", f"{start:.0f}",
            "--end-x", f"{x:.0f}", "--end-y", f"{end:.0f}", "--duration", "0.4", "--udid", udid()])
    else:
        sh([axe_binary(), "gesture", presets[args.direction], "--udid", udid()])
    print(f"swiped {args.direction}")


def cmd_button(args):
    sh([axe_binary(), "button", args.name, "--udid", udid()])
    print(f"pressed {args.name}")


def cmd_tree(args):
    nodes = ui_tree()
    if args.json:
        print(json.dumps(nodes, indent=1))
        return
    for node in walk(nodes):
        ident, label, value = node.get("AXUniqueId"), node.get("AXLabel"), node.get("AXValue")
        value = None if value is None else str(value)
        if not (ident or label or value):
            continue
        frame = node.get("frame") or {}
        box = f"{frame.get('x', 0):.0f},{frame.get('y', 0):.0f} {frame.get('width', 0):.0f}x{frame.get('height', 0):.0f}"
        print(" | ".join([node.get("type") or "?", ident or "-", label or "-", value or "-", box]))


def cmd_wait(args):
    selector(args)
    deadline = time.time() + args.timeout
    while True:
        found = [n for n in walk(ui_tree()) if matches(n, args)]
        if bool(found) != args.gone:
            print("gone" if args.gone else f"found {len(found)}")
            return
        if time.time() > deadline:
            raise ControlError(f"timed out after {args.timeout}s waiting for {'absence of ' if args.gone else ''}{vars(args)}")
        time.sleep(0.4)


def cmd_shot(args):
    path = evidence_path(args.name, ".png")
    simctl("io", udid(), "screenshot", str(path))
    print(path.relative_to(ROOT))


def cmd_clipboard(args):
    """Assert on the simulator pasteboard: --clear empties it; --contains/--not-contains poll it."""
    if args.clear:
        device = udid()
        simctl("list", "-j", "devicetypes", check=False)  # resolves the simctl path
        subprocess.run([_simctl, "pbcopy", device], input="", text=True, check=False)
        print("cleared")
        return
    deadline = time.time() + args.timeout
    while True:
        text = simctl("pbpaste", udid(), check=False).stdout
        ok = all(t in text for t in args.contains or []) and not any(t in text for t in args.not_contains or [])
        if ok:
            print(f"pasteboard ({len(text)} chars):\n{text}" if args.show or not (args.contains or args.not_contains) else f"pasteboard ok ({len(text)} chars)")
            return
        if time.time() > deadline:
            raise ControlError(f"pasteboard check failed; contains={args.contains} not_contains={args.not_contains}; got: {text[:400]!r}")
        time.sleep(0.4)


def cmd_container(args):
    print(simctl("get_app_container", udid(), BUNDLE, "data").stdout.strip())


def cmd_logs(args):
    out = simctl("spawn", udid(), "log", "show", "--last", args.last, "--style", "compact",
                 "--predicate", 'process == "Wonder"', check=False).stdout
    print("\n".join(out.splitlines()[-args.lines:]))


def cmd_sync(args):
    print("synced")


def cmd_run(args):
    """Run a scenario: one wonderctl command per line; '#' comments; stops at the first failure."""
    script = Path(args.file)
    if not script.is_absolute():
        script = ROOT / script
    lines = [l.strip() for l in script.read_text().splitlines()]
    steps = [l for l in lines if l and not l.startswith("#")]
    started = time.time()
    for number, step in enumerate(steps, 1):
        words = shlex.split(step)
        if words[0] in {"run", "sync"}:
            raise ControlError(f"step {number}: '{words[0]}' is not allowed inside a scenario")
        print(f"[{number}/{len(steps)}] {step}", flush=True)
        step_started = time.time()
        try:
            dispatch(parser().parse_args(words))
            print(f"    {time.time() - step_started:.1f}s", flush=True)
        except (ControlError, subprocess.TimeoutExpired) as error:
            shot = evidence_path(f"{script.stem}-failed-step{number}", ".png")
            simctl("io", udid(), "screenshot", str(shot), check=False)
            raise ControlError(f"{script.name} failed at step {number} ({step}): {error}\nscreenshot: {shot.relative_to(ROOT)}")
    print(f"PASS {script.name}: {len(steps)} steps in {time.time() - started:.1f}s")


def dispatch(args):
    return args.func(args)


def parser():
    p = argparse.ArgumentParser(prog="wonderctl", description=__doc__)
    p.add_argument("--host", default=os.environ.get("WONDER_CONTROL_HOST"), help="run on this SSH host (e.g. mac-mini)")
    p.add_argument("--device", choices=sorted(PROFILES), default=os.environ.get("WONDER_CONTROL_PROFILE", "iphone"),
                   help="simulator profile (default iphone)")
    sub = p.add_subparsers(dest="command", required=True)

    def add(name, func, help_text):
        command = sub.add_parser(name, help=help_text)
        command.set_defaults(func=func)
        return command

    add("doctor", cmd_doctor, "report Xcode, AXe, device, build and install state")
    c = add("device", cmd_device, "create/boot the dedicated simulator and print its UDID")
    c.add_argument("--shutdown", action="store_true")
    c.add_argument("--erase", action="store_true", help="erase to a fresh-install state first (recreates the Duo)")
    c.add_argument("--recreate", action="store_true", help="delete and create the simulator again, then boot it")
    c = add("build", cmd_build, "build TestingDiagnostics for the simulator and install it")
    c.add_argument("--no-install", action="store_true")
    add("install", cmd_install, "install the last build")
    c = add("launch", cmd_launch, "relaunch Wonder Testing, optionally with fixtures")
    c.add_argument("--fixture", action="append", help="fixture name (e.g. fixtures) or full flag")
    c.add_argument("--arg", action="append", help="extra launch argument")
    c.add_argument("--env", action="append", help="KEY=VALUE for the app process")
    c = add("back", cmd_back, "tap the navigation back control (iPhone and Duo)")
    c.add_argument("--timeout", type=float, default=10)
    add("terminate", cmd_terminate, "terminate Wonder Testing")
    add("fixtures", cmd_fixtures, "list launch flags the app understands")
    c = add("open", cmd_open, "open a URL (deep link) in the simulator")
    c.add_argument("url")
    for name, func, text in (("tap", cmd_tap, "tap by accessibility id/label or x,y"),
                             ("wait", cmd_wait, "wait for an element (or its absence)")):
        c = add(name, func, text)
        c.add_argument("--id")
        c.add_argument("--label")
        c.add_argument("--timeout", type=float, default=10)
        if name == "tap":
            c.add_argument("--xy", help="x,y in points")
            c.add_argument("--type", help="accessibility type when an id matches several elements, e.g. Button")
        else:
            c.add_argument("--contains", help="substring of label or value")
            c.add_argument("--gone", action="store_true")
    c = add("hold", cmd_hold, "long-press an element found by id/label/contains")
    c.add_argument("--id")
    c.add_argument("--label")
    c.add_argument("--contains")
    c.add_argument("--nth", type=int, default=0, help="which match, from 0")
    c.add_argument("--seconds", type=float, default=1.2)
    c.add_argument("--timeout", type=float, default=10)
    c.add_argument("--max-y-offset", type=float, default=40, help="press no lower than this far into tall elements")
    c = add("type", cmd_type, "type text into the focused field")
    c.add_argument("text")
    c = add("swipe", cmd_swipe, "scroll or edge-swipe")
    c.add_argument("direction", choices=["up", "down", "left", "right"])
    c.add_argument("--in", dest="inside", help="drag inside the element with this accessibility id")
    c = add("button", cmd_button, "press a hardware button")
    c.add_argument("name", choices=["home", "lock", "side-button", "siri", "apple-pay"])
    c = add("tree", cmd_tree, "print the accessibility tree")
    c.add_argument("--json", action="store_true")
    c = add("shot", cmd_shot, "save a screenshot under .local/control/evidence")
    c.add_argument("name", nargs="?", default="screen")
    c = add("clipboard", cmd_clipboard, "check or clear the simulator pasteboard")
    c.add_argument("--clear", action="store_true")
    c.add_argument("--contains", action="append")
    c.add_argument("--not-contains", action="append")
    c.add_argument("--show", action="store_true")
    c.add_argument("--timeout", type=float, default=5)
    add("container", cmd_container, "print the app's data container path")
    c = add("logs", cmd_logs, "recent Wonder process logs")
    c.add_argument("--last", default="2m")
    c.add_argument("--lines", type=int, default=200)
    add("sync", cmd_sync, "with --host: copy the working tree and do nothing else")
    c = add("run", cmd_run, "run a scenario file of wonderctl steps")
    c.add_argument("file")
    return p


def remote(args, argv):
    host = args.host
    forwarded = []
    skip = False
    for item in argv:
        if skip:
            skip = False
            continue
        if item == "--host":
            skip = True
            continue
        if item.startswith("--host="):
            continue
        forwarded.append(item)
    if args.command in SYNC_COMMANDS:
        sh(["ssh", host, f"mkdir -p {REMOTE_DIR}"])
        # openrsync does not reliably protect .gitignore'd paths from --delete; name them.
        protected = ["/.git/", "/.claude/", "/.local/", "target/", "node_modules/", ".build/", "DerivedData/", "__pycache__/"]
        sh(["rsync", "-a", "--delete", *[f"--exclude={path}" for path in protected], "--filter=:- .gitignore",
            f"{ROOT}/", f"{host}:{REMOTE_DIR}/"])
    command = f"export PATH={REMOTE_PATH}; cd {REMOTE_DIR} && python3 scripts/wonderctl {shlex.join(forwarded)}"
    code = subprocess.run(["ssh", host, command]).returncode
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    subprocess.run(["rsync", "-a", f"{host}:{REMOTE_DIR}/.local/control/", f"{CONTROL}/"],
                   capture_output=True)
    return code


def main(argv):
    user_xcode = Path.home() / "Applications/Xcode.app/Contents/Developer"
    if "DEVELOPER_DIR" not in os.environ and user_xcode.exists():
        os.environ["DEVELOPER_DIR"] = str(user_xcode)
    args = parser().parse_args(argv)
    global DEVICE_NAME, DEVICE_TYPES
    DEVICE_NAME, DEVICE_TYPES = PROFILES[args.device]
    os.environ["WONDER_CONTROL_PROFILE"] = args.device
    if args.host:
        return remote(args, argv)
    CONTROL.mkdir(parents=True, exist_ok=True)
    LOCKS.mkdir(parents=True, exist_ok=True)
    exclusive = args.command in {"build", "run", "device", "install"}
    with open(LOCKS / f"{args.device}.lock", "w") as lock:
        if exclusive and os.environ.get("WONDER_CONTROL_WAIT") == "1":
            print(f"waiting for '{DEVICE_NAME}'", file=sys.stderr, flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
        elif exclusive:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print(f"another wonderctl build/run owns '{DEVICE_NAME}' on this Mac; wait for it", file=sys.stderr)
                return 75
        try:
            return dispatch(args) or 0
        except (ControlError, subprocess.TimeoutExpired) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
